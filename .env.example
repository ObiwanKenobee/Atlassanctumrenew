# ==============================================================================
# ATLAS SANCTUM — PRODUCTION & DEVELOPMENT ENVIRONMENT SPECIFICATION
# Comprehensive configuration for Cyber-Physical Systems, Epistemic AI,
# Firestore / Relational Persistence, Time-Series TSDB, Object Storage,
# Edge IoT Gateways, Smart Contracts, and Earth Observation.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER RUNTIME
# ------------------------------------------------------------------------------
# PORT: Externally accessible HTTP & WebSocket port. Bound to 3000 for container reverse proxy.
PORT=3000

# NODE_ENV: Application environment mode ('development' | 'production' | 'test')
NODE_ENV=development

# APP_URL: Canonical public application URL (Cloud Run Dev, Staging, or Custom Domain)
# Cloud Run Dev URL: https://ais-dev-qaor2olchy3s5ihauswgim-695584616156.europe-west2.run.app
# Cloud Run Pre URL: https://ais-pre-qaor2olchy3s5ihauswgim-695584616156.europe-west2.run.app
# Production Domain: https://atlas.sanctum.earth
APP_URL=https://ais-dev-qaor2olchy3s5ihauswgim-695584616156.europe-west2.run.app

# CORS_ORIGIN: Allowed origins for API, WebSocket, and iframe embeds (comma-separated)
CORS_ORIGIN=https://ais-dev-qaor2olchy3s5ihauswgim-695584616156.europe-west2.run.app,https://ais-pre-qaor2olchy3s5ihauswgim-695584616156.europe-west2.run.app,https://atlas.sanctum.earth,http://localhost:3000

# DISABLE_HMR: Control Hot Module Replacement in development sandbox (set to 'true' in AI Studio)
DISABLE_HMR=true

# VERCEL: Set to '1' when deployed to Vercel Serverless environment
VERCEL=

# ------------------------------------------------------------------------------
# 2. EPISTEMIC AI & REASONING ENGINE (Google Gemini API)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Server-side Gemini API key for causal inference, multimodal reasoning, and simulation
# Managed via Settings menu. NEVER expose this key to browser clients.
GEMINI_API_KEY=

# GEMINI_MODEL: Primary model for high-throughput epistemic intelligence
GEMINI_MODEL=gemini-3.8-flash

# GEMINI_PRO_MODEL: High-depth model for complex systemic synthesis and deep research
GEMINI_PRO_MODEL=gemini-2.5-pro

# GEMINI_THINKING_BUDGET: Token allocation for extended reasoning and causal deliberation
GEMINI_THINKING_BUDGET=2048

# ------------------------------------------------------------------------------
# 3. ATLAS DEVELOPER SDK & API GATEWAY
# ------------------------------------------------------------------------------
# ATLAS_API_KEY: Server-side master API key for developer REST and WebSocket endpoints
ATLAS_API_KEY=atlas_live_sec_992619843911_eugeneochako48

# VITE_ATLAS_API_KEY: Public client-side token for interactive SDK sandbox and playground
VITE_ATLAS_API_KEY=atlas_demo_pub_sanctum_earth_2026

# API_RATE_LIMIT_MAX: Max requests per client window (900 seconds)
API_RATE_LIMIT_MAX=1000

# RATE_LIMIT_WINDOW_MS: Window duration in milliseconds for rate limiter (15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# ------------------------------------------------------------------------------
# 4. FIREBASE & CLOUD FIRESTORE PERSISTENCE
# ------------------------------------------------------------------------------
# Server-side Firebase Admin / Project Credentials
FIREBASE_PROJECT_ID=gen-lang-client-0309966576
FIRESTORE_DATABASE_ID=ai-studio-atlassanctum-057b8dc9-f704-4eef-9433-c582431b22c7
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Client-Side Exposed Firebase Config (Vite public variables for browser auth & sync)
VITE_FIREBASE_API_KEY=AIzaSyDqethmQR-HEjUknWwC3-SeI_riUEOvedM
VITE_FIREBASE_AUTH_DOMAIN=gen-lang-client-0309966576.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=gen-lang-client-0309966576
VITE_FIREBASE_DATABASE_ID=ai-studio-atlassanctum-057b8dc9-f704-4eef-9433-c582431b22c7
VITE_FIREBASE_STORAGE_BUCKET=gen-lang-client-0309966576.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=992619843911
VITE_FIREBASE_APP_ID=1:992619843911:web:beec1a9a57d30d9182bc62
VITE_FIREBASE_OAUTH_CLIENT_ID=992619843911-qdeksdbg08k45mni6udtj979pud50ie0.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 5. RELATIONAL SYSTEM OF RECORD (PostgreSQL 16+)
# Multi-tenant tables: organizations, assets, verification proofs, work orders
# ------------------------------------------------------------------------------
# DATABASE_URL: Standard PostgreSQL connection string with connection pool
DATABASE_URL=postgresql://atlas_user:password@localhost:5432/atlas_sanctum?sslmode=require

# Individual connection parameters (alternative to DATABASE_URL)
PGHOST=localhost
PGPORT=5432
PGDATABASE=atlas_sanctum
PGUSER=atlas_user
PGPASSWORD=
PGSSLMODE=require

# ------------------------------------------------------------------------------
# 6. TIME-SERIES TELEMETRY ENGINE (TimescaleDB / Hypertable TSDB)
# Sub-second ingestion of telemetry packets: water flow, soil moisture, electrical flux
# ------------------------------------------------------------------------------
TIMESCALE_URL=postgresql://atlas_telemetry:password@localhost:5432/atlas_timeseries?sslmode=require

# ------------------------------------------------------------------------------
# 7. VECTOR STORE & SEMANTIC RETRIEVAL (pgvector / Dedicated Vector DB)
# High-dimensional embeddings for research evidence, citizen reports, policy briefs
# ------------------------------------------------------------------------------
VECTOR_DB_URL=postgresql://atlas_vector:password@localhost:5432/atlas_sanctum
EMBEDDING_MODEL=text-embedding-004

# ------------------------------------------------------------------------------
# 8. OBJECT STORAGE (S3-Compatible Storage: AWS S3 / Cloud Storage / MinIO)
# Drone scans, thermal multispectral imagery, inspection photos, firmware blobs
# ------------------------------------------------------------------------------
S3_ENDPOINT=https://s3.amazonaws.com
S3_PORT=443
S3_USE_SSL=true
S3_REGION=us-east-1
S3_BUCKET_NAME=atlas-sanctum-artifacts
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_URL=https://artifacts.atlas.sanctum.earth
S3_UPLOAD_MAX_BYTES=104857600
S3_SIGNED_URL_EXPIRY_SECONDS=3600
S3_TELEMETRY_ARCHIVE_BUCKET=atlas-telemetry-cold-archive
S3_EVIDENCE_ATTACHMENTS_BUCKET=atlas-evidence-chain-vault
S3_FIRMWARE_RELEASES_BUCKET=atlas-edge-firmware-signed

# ------------------------------------------------------------------------------
# 9. EVENT BUS & MESSAGE BROKER (NATS / Kafka / Redpanda / Redis)
# Asynchronous event pipeline: sensor.reading -> anomaly.detected -> work_order.generated
# ------------------------------------------------------------------------------
# NATS Connection & JetStream Architecture
NATS_URL=nats://localhost:4222
NATS_CLUSTER_ID=atlas-cluster-prod
NATS_CLIENT_NAME=atlas-core-service
NATS_USER=atlas_service_worker
NATS_PASSWORD=
NATS_TOKEN=
NATS_NKEY_SEED=
NATS_JWT=
NATS_TLS_CA_CERT=
NATS_TLS_CLIENT_CERT=
NATS_TLS_CLIENT_KEY=
NATS_JETSTREAM_ENABLED=true
NATS_STREAM_NAME=ATLAS_EVENTS_STREAM
NATS_SUBJECT_PREFIX=atlas.events
NATS_CONSUMER_NAME=atlas-telemetry-consumer
NATS_MAX_RECONNECT_ATTEMPTS=10
NATS_RECONNECT_TIME_WAIT_MS=2000
NATS_REQUEST_TIMEOUT_MS=5000

# Auxiliary Message Brokers & Caching
KAFKA_BROKERS=localhost:9092
REDIS_URL=redis://:password@localhost:6379/0

# ------------------------------------------------------------------------------
# 10. CYBER-PHYSICAL IOT & EDGE GATEWAYS (MQTT / CoAP / SCADA)
# Hardware bi-directional telemetry & control for LifePods, Water Nodes, LifeShields
# ------------------------------------------------------------------------------
MQTT_BROKER_URL=mqtts://devices.atlas.sanctum.earth:8883
MQTT_USERNAME=atlas_gateway
MQTT_PASSWORD=
DEVICE_GATEWAY_PORT=8883
DEVICE_JWT_SECRET=
FIRMWARE_SIGNING_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# 11. SECURITY, AUTHENTICATION & DATA PRIVACY
# ------------------------------------------------------------------------------
# JWT_SECRET: Cryptographic secret for signing operator and field officer sessions
JWT_SECRET=atlas_sanctum_super_secure_jwt_signing_token_min_32_chars

# SESSION_SECRET: Secret for signing HTTP session cookies
SESSION_SECRET=atlas_sanctum_session_encryption_key_at_least_32_chars

# DATA_ENCRYPTION_KEY: AES-256 master key for encrypting GPS coordinates & citizen PII at rest
DATA_ENCRYPTION_KEY=

# ------------------------------------------------------------------------------
# 12. OBSERVABILITY, DISTRIBUTED TRACING & TELEMETRY APM
# ------------------------------------------------------------------------------
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=atlas-sanctum-core
SENTRY_DSN=

# ------------------------------------------------------------------------------
# 13. CAPITAL, SMART CONTRACTS & ESCROW DISBURSEMENT
# ------------------------------------------------------------------------------
# STRIPE: Capital contribution tiers, enterprise verification licenses
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# EVM / BASE L2: Milestone-triggered smart contract escrows
ETHEREUM_RPC_URL=https://mainnet.base.org
ESCROW_CONTRACT_ADDRESS=

# ------------------------------------------------------------------------------
# 14. EARTH OBSERVATION & SATELLITE GIS INTEGRATIONS
# ------------------------------------------------------------------------------
# SENTINEL_HUB: Multispectral vegetation, NDVI, and water index retrieval
SENTINEL_HUB_API_KEY=

# GOOGLE_MAPS: Bioregional spatial coordinate resolution & terrain rendering
GOOGLE_MAPS_API_KEY=
