rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 1. User Profiles & Preferences
    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // 2. Epistemic Provenance Data Collection (Section 30 standard)
    match /provenance_data/{recordId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if false; // Immutable scientific lineage
    }

    // 3. Moral Intelligence Audit Logs (High-impact interaction traceability)
    match /moral_audit_logs/{logId} {
      allow read: if true;
      allow create: if true; // Allows tracking from all participants & system triggers
      allow update, delete: if false; // Immutable audit log
    }

    // 4. AI Conversations
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // 5. User Saved Generations & Interventions
    match /user_generations/{genId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // 6. Community Proposals
    match /community_proposals/{proposalId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // 7. System Dynamics Models & Simulation Scenarios
    match /system_models/{modelId} {
      allow read: if true;
      allow create, update: if true; // Allow models to be saved/calibrated by users & simulations
      allow delete: if isSignedIn();
    }

    // 8. Field Lab Notes & Audio Transcripts (Living Research Logs)
    match /field_lab_notes/{noteId} {
      allow read: if true;
      allow create: if true; // Allow field scientists & community observers to record empirical field notes
      allow update, delete: if isSignedIn();
    }

    // 9. Human Flourishing & Epistemic Impact Records (Longitudinal Telemetry)
    match /impact_records/{recordId} {
      allow read: if true;
      allow create, update: if true; // Allows field and telemetry updates
      allow delete: if isSignedIn();
    }
  }
}
