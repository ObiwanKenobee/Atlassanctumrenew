rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 0. Connection validation and health probes
    match /test/{testId} {
      allow read: if true;
    }

    match /system_metadata/{id} {
      allow read: if true;
    }

    // 1. User Profiles & Preferences
    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // 2. Epistemic Provenance Data Collection (Section 30 standard)
    match /provenance_data/{recordId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if false; // Immutable scientific lineage
    }

    // 3. Moral Intelligence Audit Logs (High-impact interaction traceability)
    match /moral_audit_logs/{logId} {
      allow read: if true;
      allow create: if true; // Allows tracking from all participants & system triggers
      allow update, delete: if false; // Immutable audit log
    }

    // 4. AI Conversations
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // 5. User Saved Generations & Interventions
    match /user_generations/{genId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // 6. Community Proposals
    match /community_proposals/{proposalId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // 7. System Dynamics Models & Simulation Scenarios
    match /system_models/{modelId} {
      allow read: if true;
      allow create, update: if true; // Allow models to be saved/calibrated by users & simulations
      allow delete: if isSignedIn();
    }

    // 8. Field Lab Notes & Audio Transcripts (Living Research Logs)
    match /field_lab_notes/{noteId} {
      allow read: if true;
      allow create: if true; // Allow field scientists & community observers to record empirical field notes
      allow update, delete: if isSignedIn();
    }

    // 9. Human Flourishing & Epistemic Impact Records (Longitudinal Telemetry)
    match /impact_records/{recordId} {
      allow read: if true;
      allow create, update: if true; // Allows field and telemetry updates
      allow delete: if isSignedIn();
    }

    // 10. Bioregional Knowledge Graph Custom Labels & Color Tags
    match /bioregional_custom_tags/{tagId} {
      allow read: if true;
      allow create, update: if true; // Allow stewards and users to tag graph nodes across sessions
      allow delete: if true;
    }

    // 11. Cyber-Physical Assets & Digital Twins Registry
    match /assets/{assetId} {
      allow read: if true;
      allow create, update: if true; // Allows edge devices and operator syncing
      allow delete: if isSignedIn();
    }

    // 12. Telemetry Ingestion Historical Archive
    match /telemetry_records/{recordId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false; // Immutable sensor reading stream
    }

    // 13. Collectible Impact Badges (Citizen profile unlocked tokens)
    match /impact_badges/{badgeId} {
      allow read: if true;
      allow create, update: if true; // Allows offline and client-side badge manager syncing
      allow delete: if isSignedIn();
    }

    // 14. Collaborative Stewardship Teams & Goals
    match /stewardship_teams/{teamId} {
      allow read: if true;
      allow create, update: if true; // Allows team creation, member joining, and shared goal updates
      allow delete: if isSignedIn();
    }

    // 15. Bioregional Goals
    match /bioregional_goals/{goalId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSignedIn();
    }

    // 16. Privacy Audit Logs
    match /privacy_audit_logs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }
  }
}
