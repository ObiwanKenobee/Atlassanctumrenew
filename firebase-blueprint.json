{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered citizen researcher and systems designer profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "role": { "type": "string", "maxLength": 128 },
        "accessLevel": { "type": "string", "enum": ["visitor", "researcher", "steward", "systems_architect", "council_admin"] },
        "themePreference": { "type": "string", "enum": ["dark", "solarized", "biophilic_night"] },
        "reducedMotion": { "type": "boolean" },
        "telemetryStreamActive": { "type": "boolean" },
        "ethicalReviewNotification": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLoginAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid"]
    },
    "ProvenanceRecord": {
      "title": "ProvenanceRecord",
      "description": "Scientific, empirical, and telemetry lineage metadata for verified civilization metrics",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "source": { "type": "string", "maxLength": 256 },
        "sourceType": { 
          "type": "string", 
          "enum": ["satellite_telemetry", "iot_sensor_mesh", "field_audit", "peer_reviewed_model", "community_reporting"] 
        },
        "collectedAt": { "type": "string" },
        "calculationMethod": { "type": "string", "maxLength": 1000 },
        "certaintyScore": { "type": "number" },
        "verifier": { "type": "string", "maxLength": 256 },
        "verifierRole": { "type": "string", "maxLength": 128 },
        "cryptographicHash": { "type": "string", "maxLength": 128 },
        "assumptions": { "type": "array" },
        "lastAudited": { "type": "string" },
        "datasetName": { "type": "string", "maxLength": 256 },
        "spatialResolution": { "type": "string", "maxLength": 128 },
        "governanceEntity": { "type": "string", "maxLength": 256 },
        "epistemicTier": { "type": "string", "enum": ["primary_instrument", "consensus_model", "derivative_heuristic"] }
      },
      "required": ["source", "sourceType", "certaintyScore", "verifier", "cryptographicHash", "calculationMethod"]
    },
    "MoralAuditLog": {
      "title": "MoralAuditLog",
      "description": "Moral Intelligence immutable audit trail for high-impact interventions and systemic decisions",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 128 },
        "action": { "type": "string", "maxLength": 256 },
        "feature": { 
          "type": "string", 
          "enum": ["moral_intelligence", "simulator", "live_voice", "multimodal_generation", "asset_tokenization", "telemetry_calibration", "governance_vote"] 
        },
        "impactTier": { 
          "type": "string", 
          "enum": ["low", "moderate", "high", "civilizational_critical"] 
        },
        "moralAlignmentScore": { "type": "number" },
        "parameters": { "type": "object" },
        "ethicalNotes": { "type": "string", "maxLength": 1000 },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "action", "feature", "impactTier"]
    },
    "SystemModelDocument": {
      "title": "SystemModelDocument",
      "description": "Systems Dynamics Stock-Flow Model definition and calibrated simulation state",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 256 },
        "bioregionOrDomain": { "type": "string", "maxLength": 256 },
        "version": { "type": "string", "maxLength": 64 },
        "timeHorizonMonths": { "type": "number" },
        "timeStepUnit": { "type": "string" },
        "stocks": { "type": "array" },
        "flows": { "type": "array" },
        "variables": { "type": "array" },
        "relationships": { "type": "array" },
        "feedbackLoops": { "type": "array" },
        "constraints": { "type": "array" },
        "assumptions": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "stocks", "flows"]
    },
    "BioregionalCustomTag": {
      "title": "BioregionalCustomTag",
      "description": "User-defined custom labels, steward priorities, and color-coded tags on ecological graph nodes",
      "type": "object",
      "properties": {
        "nodeId": { "type": "string", "maxLength": 128 },
        "customLabel": { "type": "string", "maxLength": 256 },
        "tagColor": { "type": "string", "maxLength": 32 },
        "tagCategory": { "type": "string", "maxLength": 128 },
        "notes": { "type": "string", "maxLength": 1000 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["nodeId", "tagColor"]
    },
    "ImpactBadge": {
      "title": "ImpactBadge",
      "description": "Collectible digital ecological badges earned by stewards based on verified contributions",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "badgeKey": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "tier": { "type": "string", "enum": ["bronze", "silver", "gold", "platinum", "emerald"] },
        "category": { "type": "string", "enum": ["hydrology", "carbon", "canopy", "audit", "community", "hazard_response"] },
        "unlockedAt": { "type": "string", "format": "date-time" },
        "criteriaMet": { "type": "string", "maxLength": 512 },
        "proofHash": { "type": "string", "maxLength": 128 },
        "reputationAwarded": { "type": "number" },
        "telemetrySnapshot": { "type": "object" }
      },
      "required": ["userId", "badgeKey", "name", "tier", "proofHash"]
    },
    "StewardshipTeam": {
      "title": "StewardshipTeam",
      "description": "Collaborative mission-based team tracking shared bioregional goals and collective impact",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "bioregion": { "type": "string", "maxLength": 128 },
        "missionTitle": { "type": "string", "maxLength": 256 },
        "missionGoal": { "type": "string", "maxLength": 512 },
        "missionTarget": { "type": "number" },
        "missionCurrent": { "type": "number" },
        "missionUnit": { "type": "string", "maxLength": 64 },
        "collectiveReputation": { "type": "number" },
        "rank": { "type": "number" },
        "members": { "type": "array" },
        "sharedBadges": { "type": "array" },
        "creatorId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "bioregion", "missionTitle", "creatorId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User account documents and platform preferences"
    },
    "/provenance_data/{recordId}": {
      "schema": "ProvenanceRecord",
      "description": "Verified epistemic provenance records for indicators, indicators datasets, and interventions"
    },
    "/moral_audit_logs/{logId}": {
      "schema": "MoralAuditLog",
      "description": "Systemic ethical audit trail logging user interactions with high-impact features"
    },
    "/system_models/{modelId}": {
      "schema": "SystemModelDocument",
      "description": "Persisted Systems Dynamics models and scenario calibrations"
    },
    "/bioregional_custom_tags/{tagId}": {
      "schema": "BioregionalCustomTag",
      "description": "User and steward custom annotations and color-coded tags on bioregional knowledge graph nodes"
    },
    "/assets/{assetId}": {
      "schema": "Asset",
      "description": "Cyber-physical asset registry and live digital twin state documents"
    },
    "/impact_badges/{badgeId}": {
      "schema": "ImpactBadge",
      "description": "Collectible digital impact badges awarded to ecological stewards"
    },
    "/stewardship_teams/{teamId}": {
      "schema": "StewardshipTeam",
      "description": "Collaborative stewardship teams and collective restoration mission trackers"
    }
  }
}
